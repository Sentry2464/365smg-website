# /etc/fdot-live.env (root:root, chmod 600). Live FDOT video through Cloudflare Stream.
# See VIDEO.md. Type the token in on VM 151; never paste it into chat or email.

# Cloudflare account (not secret) and an API token with Account > Stream > Edit only,
# limited to this account and, ideally, to the office's public IP.
CF_ACCOUNT_ID=00b7e436510272be78f3eff87bda1196
CF_API_TOKEN=
# From the Stream page in the dashboard: customer-<code>.cloudflarestream.com
STREAM_CUSTOMER_DOMAIN=
# Pages allowed to play the video (the gate's player page).
STREAM_ALLOWED_ORIGINS=globe.365securitymg.com
# Stream may only play live inputs that record; recordings are deleted after each session.
# Try "off" once: if live video still plays, keep it (nothing is recorded at all).
STREAM_RECORDING_MODE=automatic
STREAM_DELETE_RECORDINGS=1

# Limits. FDOT: one camera per client at a time, at most 5 minutes per session
# (LIVE_SESSION_MIN can only be lowered). Minutes are charged per session when it starts.
LIVE_SESSION_MIN=5
LIVE_CLIENT_MONTHLY_MIN=120
# Whole account, per month: about $1 per 1,000 minutes, so 5000 is about $5.
LIVE_MONTHLY_MIN=5000
# Cameras pulled from FDOT at once (~1.5 Mbps of office upload each).
LIVE_MAX_CAMERAS=5
# Stop pulling a camera this long after its last viewer.
LIVE_IDLE_STOP_S=30
# "*" for every signed-in client, or client ids separated by commas (e.g. for a pilot).
LIVE_CLIENTS=*

# Only if FDOT gives us a way to authenticate to its video servers: extra request headers,
# "Name: value", several separated by \n.
#FDOT_VIDEO_HEADERS=
