# /etc/gev-gate.env (root:root, chmod 600). Copy to the VM and fill in GATE_SECRET.

# Same value as SMG_GLOBE_SECRET in /etc/smg-portal.env on VM 150. 32+ characters, e.g.
#   openssl rand -base64 48
# Enter it directly on each VM; never paste it into chat or email.
GATE_SECRET=

# Where cloudflared sends globe.365securitymg.com.
GATE_LISTEN=127.0.0.1
GATE_PORT=4180
# The map behind the gate. The Host header sent to it is localhost:<port>.
#   OSIRIS client edition (globe/osiris, osiris.service):  http://127.0.0.1:4174
#   God's Eye View (vite preview):                         http://127.0.0.1:4173
GATE_UPSTREAM=http://127.0.0.1:4174

# Only this page may frame the gate's own pages (set GEV_EMBED_FRAME_ANCESTORS to match).
GATE_FRAME_ANCESTORS=https://portal.365securitymg.com
GATE_COOKIE_HOURS=12
# Ticket checks per minute: per client IP, and in total.
GATE_TICKETS_PER_MINUTE=30
GATE_TICKETS_PER_MINUTE_ALL=600
# Live camera video through the gate: keep 0 behind Cloudflare (video through a Tunnel public
# hostname isn't allowed on our plan). Clients use the "Watch live on FL511" link instead.
GATE_LIVE_VIDEO=0
# Testing only, over plain http on a name other than localhost: cookie without Secure.
GATE_INSECURE_COOKIE=0
