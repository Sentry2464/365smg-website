+/**
+ * 365 SMG client edition: FDOT stills are fetched by our server (at most once a minute per
+ * camera, identified as us) rather than by each viewer's browser. See /api/smg/fdot-snapshot.
+ */
+export function viaOurServer(url: string): string {
+  try {
+    const host = new URL(url).hostname.toLowerCase();
+    if (host === 'fl511.com' || host.endsWith('.fl511.com')) return `/api/smg/fdot-snapshot?url=${encodeURIComponent(url)}`;
+  } catch {
+    // not an absolute URL: leave it
+  }
+  return url;
+}
